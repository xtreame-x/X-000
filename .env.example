# ══════════════════════════════════════════════════════════════════════════════
#  Oryn Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Primary AI Provider (Google Gemini Free Tier recommended: 15 RPM, 1M TPM)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Drive Integration ──────────────────────────────────────────────────
# 1-click setup: double-click auth_drive.bat (or run `python auth_drive.py`).
# Google opens in your browser; approving the consent screen saves a permanent
# refresh token below. Inside Oryn the same flow is `auth drive`.
#
# Requires a Desktop app OAuth client (Google Drive API enabled) from
# https://console.cloud.google.com/apis/credentials — add it with
# `python auth_drive.py menu` (option 2) or paste the two values here once.
# GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret_here
#
# Written automatically by the login flow — no need to edit by hand:
# GOOGLE_REFRESH_TOKEN=1//your_refresh_token_here
# GOOGLE_ACCESS_TOKEN=ya29.your_short_lived_token_here

# ── Notion Integration ────────────────────────────────────────────────────────
# 1-click setup: double-click auth_notion.bat (or run `python auth_notion.py`).
# Create a public integration at https://www.notion.so/my-integrations and add
# http://localhost:8085/oauth2callback as a redirect URI. Inside Oryn: `auth notion`.
# NOTION_CLIENT_ID=your_notion_client_id
# NOTION_CLIENT_SECRET=your_notion_client_secret
#
# Written automatically by the login flow:
# NOTION_TOKEN=secret_your_access_token
# NOTION_WORKSPACE_ID=your_workspace_id
# NOTION_WORKSPACE_NAME="Your Workspace"

# ── Optional Fallback Providers ───────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Optional Search & Web ─────────────────────────────────────────────────────
# Serper Google Search API (falls back to DuckDuckGo/Wikipedia automatically)
# SERPER_API_KEY=your_serper_key_here

# ── Optional Real Email (SMTP) ────────────────────────────────────────────────
# AGENT_SMTP_HOST=smtp.gmail.com
# AGENT_SMTP_PORT=587
# AGENT_SMTP_USER=your_email@gmail.com
# AGENT_SMTP_PASSWORD=your_app_password
# AGENT_SMTP_FROM=your_email@gmail.com

# ── Optional Location & Timezone Override ─────────────────────────────────────
# (Oryn automatically uses native Windows Geolocation and your system timezone)
# AGENT_LOCATION_LABEL=Your City, State, Country
# AGENT_LATITUDE=15.2763
# AGENT_LONGITUDE=80.0206
# AGENT_TIMEZONE=Asia/Kolkata
