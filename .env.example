# Primary AI Provider (Google Gemini Free Tier recommended: 15 RPM, 1M TPM)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback Providers
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: Fixed Location Override (if you want to override Windows Geolocation)
# AGENT_LOCATION_LABEL=Your City, State, Country
# AGENT_LATITUDE=15.2763
# AGENT_LONGITUDE=80.0206
